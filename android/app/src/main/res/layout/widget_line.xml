<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×1 widget (1.67): the plane overhead on one line; the plane mark takes the status colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_line_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Status"
        android:src="@drawable/ic_plane" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:textColor="#F3F0E8"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:text="Loading …"
        android:textColor="#959AA3"
        android:textSize="15sp" />
</LinearLayout>
